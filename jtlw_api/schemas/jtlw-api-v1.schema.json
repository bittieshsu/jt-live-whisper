    },
    "summary_url": {
     "type": [
      "string",
      "null"
     ],
     "description": "api_revision 2.4（result_schema_version 2.1）：要求 summarize 而且成功時為 /api/v1/jobs/{id}/summary，其餘為 null"
    },
    "diarization": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "required": [
      "requested",
      "engine",
      "note",
      "reason",
      "saturated"
     ],
     "description": "api_revision 2.5（result_schema_version 2.2）：講者辨識要求的與實際用的方法；沒有要求 diarize 時為 null。api_revision 2.6（result_schema_version 2.3）加 reason；api_revision 2.7（result_schema_version 2.4）加 saturated",
     "properties": {
      "requested": {
       "type": "string",
       "enum": [
        "legacy",
        "auto"
       ]
      },
      "engine": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "legacy",
        "nemotron",
        null
       ],
       "description": "實際用的方法；講者辨識失敗（diarize＝degraded）時為 null"
      },
      "note": {
       "type": [
        "string",
        "null"
       ],
       "description": "auto 退回現行方法時的原因（中文，給人看），例如超過 8 人"
      },
      "reason": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "too_many_speakers",
        "speakers_saturated",
        "nemotron_unavailable",
        "nemotron_failed",
        null
       ],
       "description": "api_revision 2.6：auto 退回現行方法時的原因代碼，給呼叫端翻成自己的語言（note 照舊）。too_many_speakers＝num_speakers 大於 8；speakers_saturated＝沒指定人數、偵測到 8 位全部用滿，而且現行方法分出超過 8 位（v2.26.4 起；以前全滿就一律退回）；nemotron_unavailable＝執行講者辨識的那台沒有 Nemotron（transformers 不到 5.18、Intel Mac 等）；nemotron_failed＝Nemotron 執行時出錯。沒有退回（或 requested 是 legacy、或講者辨識失敗）時為 null。日後可能新增代碼，不認得的請當成一般退回處理並顯示 note"
      },
      "saturated": {
       "type": "boolean",
       "description": "api_revision 2.7：沒指定人數、Nemotron 的 8 個講者位置全部用到時為 true，不論最後採用哪一種方法。現行方法分出超過 8 位而改用它時 engine=legacy、reason=speakers_saturated；否則照用 Nemotron（engine=nemotron、reason=null），結果最多 8 位，實際發言者更多時會有人被併在一起，可提醒使用者填人數（num_speakers 大於 8）後重送。Nemotron 沒有執行（requested 是 legacy、指定人數、退回其他原因）或講者辨識失敗時為 false。實測公開語料 36 場 3～7 人的會議都沒有用滿"
      }
     }
    }
   }
