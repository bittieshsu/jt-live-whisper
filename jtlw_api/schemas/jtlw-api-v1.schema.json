  "Event": {
   "type": "object",
   "required": [
    "event_id",
    "event_seq",
    "type",
    "job_id",
    "occurred_at",
    "data"
   ],
   "additionalProperties": false,
   "properties": {
    "event_id": {
     "$ref": "#/$defs/EventId"
    },
    "event_seq": {
     "$ref": "#/$defs/Seq"
    },
    "type": {
     "type": "string",
     "enum": [
      "job.accepted",
      "job.stage_changed",
      "job.progress",
      "segments.appended",
      "speakers.assigned",
      "final_segments.appended",
      "task.completed",
      "job.succeeded",
      "job.partially_succeeded",
      "job.failed",
      "job.cancelled",
      "job.expired"
     ]
    },
    "job_id": {
     "$ref": "#/$defs/JobId"
    },
    "external_ref": {
     "type": "object"
    },
    "occurred_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "data": {
     "type": "object"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.accepted"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "status",
         "queue_position",
         "profile_version"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.stage_changed"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "stage",
         "previous_stage",
         "progress"
        ],
        "properties": {
         "stage": {
          "$ref": "#/$defs/Stage"
         },
         "progress": {
          "$ref": "#/$defs/Progress"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.progress"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "progress"
        ],
        "properties": {
         "progress": {
          "$ref": "#/$defs/Progress"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "segments.appended"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "first_seq",
         "last_seq",
         "segments"
        ],
        "properties": {
         "segments": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/RawSegment"
          },
          "minItems": 1
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "speakers.assigned"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "speaker_ids",
         "assignments",
         "degraded"
        ],
        "properties": {
         "assignments": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/SpeakerAssignment"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "final_segments.appended"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "first_seq",
         "last_seq",
         "segments"
        ],
        "properties": {
         "segments": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/FinalSegment"
          },
          "minItems": 1
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "task.completed"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "task",
         "status"
        ],
        "properties": {
         "task": {
          "$ref": "#/$defs/Task"
         },
         "status": {
          "enum": [
           "succeeded",
           "failed",
           "degraded"
          ]
         },
         "error": {
          "oneOf": [
           {
            "$ref": "#/$defs/Error"
           },
           {
            "type": "null"
           }
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "enum": [
         "job.succeeded",
         "job.partially_succeeded"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "tasks",
         "result_url",
         "segment_count"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.failed"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "tasks",
         "errors"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.cancelled"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "segment_count"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "job.expired"
       }
      }
     },
     "then": {
      "properties": {
       "data": {
        "required": [
         "expired_at"
        ]
       }
      }
     }
    }
   ]
  },
  "WebhookEndpoint": {
   "type": "object",
   "required": [
    "endpoint_id",
    "url",
    "created_at",
    "active_secrets"
   ],
   "additionalProperties": false,
   "properties": {
    "endpoint_id": {
     "type": "string",
     "pattern": "^wh_"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "created_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "active_secrets": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2
    },
    "secret": {
     "type": "string",
     "description": "只在建立與輪替時回傳一次"
    }
   }
  },
  "CorrectionLevel": {
   "type": "string",
   "enum": [
    "punctuation_only",
    "standard"
   ],
   "description": "校正強度。punctuation_only：只做標點、明顯錯字與詞彙庫專有名詞，不改語序與用詞；standard：允許一般的辨識錯誤修正。預設 standard"
  },
  "JobRetryRequest": {
   "type": "object",
   "additionalProperties": false,
   "description": "重試作業；可一併更換詞彙庫或校正等級，只重跑校正（raw 段落與 seq 不變）",
   "properties": {
    "glossary": {
     "$ref": "#/$defs/Glossary"
    },
    "glossary_url": {
     "$ref": "#/$defs/GlossaryUrl"
    },
    "correction_level": {
     "$ref": "#/$defs/CorrectionLevel"
    }
   }
  },
  "CorrectionStats": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "edited_segments",
    "unchanged_segments",
    "kept_original_segments"
   ],
   "description": "校正幅度。kept_original_segments 是 jtlw 檢查後認為改動異常（改變數字、語意、專有名詞等）而保留原文的段數 model 是實際使用的校正模型名稱。",
   "properties": {
    "edited_segments": {
     "type": "integer",
     "minimum": 0
    },
    "unchanged_segments": {
     "type": "integer",
     "minimum": 0
    },
    "kept_original_segments": {
     "type": "integer",
     "minimum": 0
    },
    "model": {
     "type": [
      "string",
      "null"
     ],
     "description": "實際用來校正的 LLM 模型名稱。校正品質與模型高度相關（實測同一批語料換模型，英文的語意損壞率相差數倍），所以要記錄「這份結果是在什麼條件下產生的」"
    }
   }
  },
  "UrlSource": {
   "type": "object",
   "required": [
    "type",
    "url",
    "sha256",
    "size_bytes"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "url"
    },
    "url": {
     "type": "string",
     "format": "uri",
     "description": "須在允許的主機清單內，否則送件當下回 source_not_allowed"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
     "type": "integer",
     "minimum": 1
    },
    "content_type": {
     "type": "string"
    }
   },
   "description": "音訊來源：jtlw 自行拉檔並核對 sha256"
  },
  "UploadSource": {
   "type": "object",
   "required": [
    "type",
    "upload_id"
   ],
   "additionalProperties": false,
   "description": "api_revision 2.4：先 POST /uploads 上傳，再用回傳的 upload_id 送件。一個上傳只能給一件作業；作業處理完會刪除檔案，沒用掉的 24 小時後刪除",
   "properties": {
    "type": {
     "const": "upload"
    },
    "upload_id": {
     "type": "string",
     "pattern": "^upl_[0-9A-Z]{26}$"
    }
   }
  },
  "SummaryCitation": {
   "type": "object",
   "required": [
    "seq",
    "start_ms",
    "end_ms",
    "speaker_id",
    "source_seqs"
   ],
   "additionalProperties": false,
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 1,
     "description": "MeetingSummary.segments 的段號"
    },
    "start_ms": {
     "type": [
      "integer",
      "null"
     ]
    },
    "end_ms": {
     "type": [
      "integer",
      "null"
     ]
    },
    "speaker_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_seqs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Seq"
     },
     "description": "對應到 raw 層的 seq"
    }
   }
  },
  "SummaryItem": {
   "type": "object",
   "required": [
    "text",
    "citations"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string"
    },
    "owner": {
     "type": [
      "string",
      "null"
     ],
     "description": "只有 actions：逐字稿裡明確指名的負責人，沒有就是 null"
    },
    "due_text": {
     "type": [
      "string",
      "null"
     ],
     "description": "只有 actions：原文的期限寫法（例：下週三），不換算成日期"
    },
    "citations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/SummaryCitation"
     }
    }
   }
  },
  "UploadResponse": {
   "type": "object",
   "required": [
    "upload_id",
    "size_bytes",
    "sha256",
    "filename",
    "expires_at"
   ],
   "additionalProperties": false,
   "description": "api_revision 2.4：POST /uploads 的回應（201）",
   "properties": {
    "upload_id": {
     "type": "string",
     "pattern": "^upl_[0-9A-Z]{26}$"
    },
    "size_bytes": {
     "type": "integer",
     "minimum": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "filename": {
     "type": [
      "string",
      "null"
     ]
    },
    "expires_at": {
     "$ref": "#/$defs/Timestamp",
     "description": "沒有用來送件的話，這個時間之後刪除"
    }
   }
  },
  "MeetingSummary": {
   "type": "object",
   "required": [
    "summary_schema_version",
    "job_id",
    "language",
    "model",
    "generated_at",
    "llm_calls",
    "summary",
    "items",
    "chapters",
    "speakers",
    "segments",
    "dropped_count"
   ],
   "additionalProperties": false,
   "description": "api_revision 2.4：GET /jobs/{id}/summary 的回應。與 jt-doc-tools 的會議摘要同一套分析：每一條都必須指得回逐字稿、引用經過比對，驗不過的不輸出；摘要只從驗證過的項目寫。空陣列表示分析沒有在逐字稿裡找到該類內容，不代表會議一定沒有",
   "properties": {
    "summary_schema_version": {
     "type": "string",
     "pattern": "^1\\.[0-9]+$"
    },
    "job_id": {
     "$ref": "#/$defs/JobId"
    },
    "language": {
     "const": "zh-Hant",
     "description": "摘要與分類的文字語言（英文會議的項目文字可能保留英文原文）"
    },
    "model": {
     "type": "string"
    },
    "generated_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "llm_calls": {
     "type": "integer",
     "minimum": 0
    },
    "summary": {
     "type": "object",
     "required": [
      "text",
      "grounded",
      "unsupported"
     ],
     "additionalProperties": false,
     "properties": {
      "text": {
       "type": "string",
       "description": "三到五句的中文摘要；分析失敗時為空字串"
      },
      "grounded": {
       "type": "boolean",
       "description": "false：摘要裡有數字或英文詞在素材中找不到（列在 unsupported）"
      },
      "unsupported": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "impacts",
      "decisions",
      "actions",
      "risks",
      "questions"
     ],
     "properties": {
      "impacts": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/SummaryItem"
       }
      },
      "decisions": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/SummaryItem"
       }
      },
      "actions": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/SummaryItem"
       }
      },
      "risks": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/SummaryItem"
       }
      },
      "questions": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/SummaryItem"
       }
      }
     },
     "description": "impacts 事件與影響、decisions 決議、actions 待辦、risks 風險、questions 未決問題"
    },
    "chapters": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "title",
       "first_seq",
       "last_seq"
      ],
      "additionalProperties": false,
      "properties": {
       "title": {
        "type": "string"
       },
       "start_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "end_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "duration_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "percentage": {
        "type": [
         "number",
         "null"
        ]
       },
       "first_seq": {
        "type": "integer"
       },
       "last_seq": {
        "type": "integer"
       }
      }
     }
    },
    "speakers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "speaker_id",
       "turn_count",
       "chars",
       "char_pct"
      ],
      "properties": {
       "speaker_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "turn_count": {
        "type": "integer"
       },
       "chars": {
        "type": "integer"
       },
       "char_pct": {
        "type": "number"
       },
       "speaking_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "percentage": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    },
    "segments": {
     "type": "array",
     "description": "分析用的段落：同一講者連續的短句合併（≤400 字、間隔 ≤3 秒）、超長的切開。引用的 seq 指這裡",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "seq",
       "speaker_id",
       "start_ms",
       "end_ms",
       "text",
       "source_seqs"
      ],
      "properties": {
       "seq": {
        "type": "integer",
        "minimum": 1
       },
       "speaker_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "start_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "end_ms": {
        "type": [
         "integer",
         "null"
        ]
       },
       "text": {
        "type": "string"
       },
       "source_seqs": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/Seq"
        }
       }
      }
     }
    },
    "dropped_count": {
     "type": "integer",
     "minimum": 0,
     "description": "模型提出、但引用驗不過而沒有輸出的項目數"
    }
   }
  }
 }
}